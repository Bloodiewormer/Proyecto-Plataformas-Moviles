<?xml version="1.0" encoding="utf-8"?>
<!--
  targetSdk 28+ blocks cleartext HTTP by default. The Lab 3 mock (Mockoon, D-25) is served
  over plain http on the emulator's host alias, so cleartext is permitted for that address
  and nothing else — the rest of the app still requires HTTPS. Remove this file and the
  `android:networkSecurityConfig` reference in the manifest once auth points at a real
  HTTPS backend.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
