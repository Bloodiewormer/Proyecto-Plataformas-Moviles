# Render environment template for the Glifo Spring Boot cloud image.
# Contains no secrets. Fill values in Render, not in this repository.
# Do not replace existing production secrets without planning their rotation.

SPRING_PROFILES_ACTIVE=cloud

# Required: Neon JDBC URL, without username or password in the URL.
# Format: jdbc:postgresql://HOST:5432/neondb?sslmode=verify-full&sslfactory=org.postgresql.ssl.DefaultJavaSSLFactory
DB_JDBC_URL=
DB_USERNAME=glifo_runtime
DB_PASSWORD=

# Required: preserve the current production value if already configured.
# For a new environment, use a random secret of at least 32 UTF-8 bytes.
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Required: one exact HTTPS browser origin, with no trailing slash.
# Native Android does not enforce browser CORS; this variable is still required.
# For an Android-only deployment, the service HTTPS origin can be used here.
CORS_ALLOWED_ORIGIN=

DB_MAX_POOL_SIZE=5

# Optional AI: empty key leaves AI operations unconfigured.
# Requests with a valid API key may incur charges; no free quota is assumed.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60

# Push remains disabled until Firebase credentials and sending are authorized.
GLIFO_FCM_ENABLED=false
FCM_ENABLED=false
GLIFO_FCM_PROJECT_ID=
GLIFO_FCM_CREDENTIALS_PATH=
GLIFO_FCM_CREDENTIALS_FILE=
GLIFO_FCM_USE_APPLICATION_DEFAULT=false
GLIFO_FCM_MAX_ATTEMPTS=3
GLIFO_FCM_RETRY_BACKOFF_MS=200

# Do not add PORT: retain the value assigned by Render.
# Do not enable Hibernate create, create-drop or update in production.
# Runtime credentials must not use the neondb_owner migration role.
# This file does not provision the database or configure the Android API URL.
