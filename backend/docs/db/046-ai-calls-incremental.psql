\set ON_ERROR_STOP on

BEGIN;
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '60s';
SET LOCAL search_path = pg_catalog;
SELECT pg_catalog.pg_advisory_xact_lock(197701, 46);

DO $identity$
BEGIN
    IF pg_catalog.current_database() <> 'neondb' OR current_user <> 'neondb_owner' THEN
        RAISE EXCEPTION 'Expected database neondb and initialization role neondb_owner';
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_class relation
        JOIN pg_catalog.pg_namespace namespace ON namespace.oid = relation.relnamespace
        JOIN pg_catalog.pg_roles owner_role ON owner_role.oid = relation.relowner
        WHERE namespace.nspname = 'public' AND relation.relname = 'ai_calls'
        AND relation.relkind = 'r' AND owner_role.rolname = current_user) THEN
        RAISE EXCEPTION 'Expected baseline table ai_calls owned by neondb_owner';
    END IF;
    IF NOT EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'glifo_runtime') THEN
        RAISE EXCEPTION 'Expected the previously initialized runtime role';
    END IF;
END
$identity$;

LOCK TABLE public.ai_calls IN ACCESS EXCLUSIVE MODE;

DO $baseline$
BEGIN
    IF ARRAY(SELECT attribute.attname::text FROM pg_catalog.pg_attribute attribute
        WHERE attribute.attrelid = 'public.ai_calls'::regclass AND attribute.attnum > 0
        AND NOT attribute.attisdropped ORDER BY attribute.attname)
        <> ARRAY['call_type', 'course_id', 'created_at', 'estimated_cost', 'id', 'input_tokens',
                 'latency_ms', 'level', 'output_tokens', 'user_id'] THEN
        RAISE EXCEPTION 'Expected the original baseline columns; partial or repeated migrations are refused';
    END IF;
    IF EXISTS (SELECT 1 FROM public.ai_calls) THEN
        RAISE EXCEPTION 'ai_calls migration requires an empty table; no historical call outcome is invented';
    END IF;
    IF pg_catalog.to_regclass('public.ai_avoided_calls') IS NOT NULL THEN
        RAISE EXCEPTION 'ai_avoided_calls already exists; partial or repeated migrations are refused';
    END IF;
END
$baseline$;

-- BEGIN MIGRATION BODY (AiCallPersistenceTest la aplica sobre un esquema temporal)
ALTER TABLE public.ai_calls
    ALTER COLUMN level DROP NOT NULL,
    ALTER COLUMN input_tokens DROP NOT NULL,
    ALTER COLUMN output_tokens DROP NOT NULL,
    ALTER COLUMN estimated_cost DROP NOT NULL,
    ALTER COLUMN estimated_cost TYPE numeric(12,8),
    ADD COLUMN model character varying(100),
    ADD COLUMN success boolean NOT NULL,
    ADD COLUMN output_accepted boolean,
    ADD COLUMN error_code character varying(64),
    ADD COLUMN error_message character varying(255),
    ADD CONSTRAINT ck_ai_calls_outcome CHECK (success = true OR (output_accepted IS NULL AND error_code IS NOT NULL));

CREATE TABLE public.ai_avoided_calls (
    id bigint GENERATED BY DEFAULT AS IDENTITY (SEQUENCE NAME public.ai_avoided_calls_id_seq) PRIMARY KEY,
    user_id bigint NOT NULL,
    course_id bigint,
    call_type character varying(16) NOT NULL,
    level character varying(12),
    created_at timestamp(6) with time zone NOT NULL,
    CONSTRAINT ck_ai_avoided_calls_type CHECK (call_type IN ('OCR_M', 'IA_00', 'IA_01', 'IA_02', 'IA_03', 'IA_04')),
    CONSTRAINT ck_ai_avoided_calls_level CHECK (level IN ('N0', 'N1', 'N1_5', 'N2', 'N3', 'UNRESOLVED')),
    CONSTRAINT fkowjjjikjo9h3aborodkmyenc9 FOREIGN KEY (user_id) REFERENCES public.users(id),
    CONSTRAINT fkod8cmx8tyymucudogx0wn5q8o FOREIGN KEY (course_id) REFERENCES public.courses(id) ON DELETE SET NULL
);
CREATE INDEX idx_ai_avoided_calls_user_created ON public.ai_avoided_calls USING btree (user_id, created_at);
-- END MIGRATION BODY

-- Mismos permisos que el resto de las tablas de la aplicación (cloud-bootstrap.psql).
GRANT SELECT, INSERT, UPDATE, DELETE ON public.ai_avoided_calls TO glifo_runtime;
GRANT USAGE, SELECT ON SEQUENCE public.ai_avoided_calls_id_seq TO glifo_runtime;

COMMIT;
