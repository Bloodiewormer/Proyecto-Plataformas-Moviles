CREATE TABLE public.glossary_suggestions (
    id bigint NOT NULL,
    created_at timestamp(6) with time zone NOT NULL,
    original_text character varying(255) NOT NULL,
    resolved_at timestamp(6) with time zone,
    status character varying(12) NOT NULL,
    suggested_correction character varying(255) NOT NULL,
    course_id bigint NOT NULL,
    note_id bigint,
    user_id bigint NOT NULL,
    CONSTRAINT ck_glossary_suggestions_status CHECK (((status)::text = ANY ((ARRAY['PENDING'::character varying, 'APPROVED'::character varying, 'REJECTED'::character varying])::text[])))
);

ALTER TABLE public.glossary_suggestions ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.glossary_suggestions_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);

CREATE TABLE public.note_pages (
    id bigint NOT NULL,
    level_reached character varying(12) NOT NULL,
    overall_confidence real NOT NULL,
    page_index integer NOT NULL,
    perceptual_hash character varying(16) NOT NULL,
    processed_at timestamp(6) with time zone,
    quality_metrics jsonb,
    regions jsonb,
    storage_uri character varying(512) NOT NULL,
    note_id bigint NOT NULL,
    CONSTRAINT ck_note_pages_confidence CHECK (((overall_confidence >= (0)::double precision) AND (overall_confidence <= (1)::double precision))),
    CONSTRAINT ck_note_pages_level CHECK (((level_reached)::text = ANY ((ARRAY['N0'::character varying, 'N1'::character varying, 'N1_5'::character varying, 'N2'::character varying, 'N3'::character varying, 'UNRESOLVED'::character varying])::text[])))
);

ALTER TABLE public.note_pages ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
