ALTER TABLE ONLY public.review_schedule
    ADD CONSTRAINT fkoprg1fo3psxpus02cfj5d6sfw FOREIGN KEY (study_item_id) REFERENCES public.study_items(id) ON DELETE CASCADE;

ALTER TABLE ONLY public.glossary_suggestions
    ADD CONSTRAINT fkp96v79t75shsnlsltc806380d FOREIGN KEY (user_id) REFERENCES public.users(id);

ALTER TABLE ONLY public.sync_queue
    ADD CONSTRAINT fkpf69i9an4nk1nane9b03snxik FOREIGN KEY (user_id) REFERENCES public.users(id);

ALTER TABLE ONLY public.topic_coverage
    ADD CONSTRAINT fkr9wd6711sv8qcans74f65urps FOREIGN KEY (syllabus_topic_id) REFERENCES public.syllabus_topics(id) ON DELETE CASCADE;

ALTER TABLE ONLY public.devices
    ADD CONSTRAINT fkrfbri1ymrwywdydc4dgywe1bt FOREIGN KEY (user_id) REFERENCES public.users(id);

INSERT INTO public.roles (name, description) VALUES ('ROLE_STUDENT', 'Default student role'), ('ROLE_TEACHER', 'Course owner and syllabus publisher'), ('ROLE_ADMIN', 'System administrator');
INSERT INTO public.privileges (name, description) VALUES ('NOTE_READ_OWN', 'Read own notes'), ('NOTE_WRITE_OWN', 'Create and edit own notes'), ('NOTE_DELETE_OWN', 'Delete own notes'), ('COURSE_READ', 'View courses'), ('COURSE_WRITE', 'Create and manage courses'), ('SYLLABUS_PUBLISH', 'Publish syllabus for owned courses'), ('GLOSSARY_WRITE', 'Manage course glossary'), ('COVERAGE_READ_OWN', 'View own topic coverage'), ('COVERAGE_READ_COURSE', 'View course-wide coverage stats'), ('STUDY_ITEM_GENERATE', 'Generate study items from notes'), ('STUDY_ATTEMPT_WRITE', 'Submit study attempts'), ('AI_VISION_INVOKE', 'Invoke AI vision services'), ('USAGE_READ_OWN', 'View own AI usage stats'), ('USAGE_READ_COURSE', 'View course AI usage stats'), ('USER_MANAGE', 'Manage users'), ('ROLE_MANAGE', 'Manage roles and privileges');
INSERT INTO public.role_privileges (role_id, privilege_id) SELECT r.id, p.id FROM public.roles r, public.privileges p WHERE r.name = 'ROLE_STUDENT' AND p.name IN ('NOTE_READ_OWN', 'NOTE_WRITE_OWN', 'NOTE_DELETE_OWN', 'COURSE_READ', 'COVERAGE_READ_OWN', 'STUDY_ITEM_GENERATE', 'STUDY_ATTEMPT_WRITE', 'AI_VISION_INVOKE', 'USAGE_READ_OWN');
INSERT INTO public.role_privileges (role_id, privilege_id) SELECT r.id, p.id FROM public.roles r, public.privileges p WHERE r.name = 'ROLE_TEACHER' AND p.name IN ('NOTE_READ_OWN', 'NOTE_WRITE_OWN', 'NOTE_DELETE_OWN', 'COURSE_READ', 'COURSE_WRITE', 'SYLLABUS_PUBLISH', 'GLOSSARY_WRITE', 'COVERAGE_READ_OWN', 'COVERAGE_READ_COURSE', 'STUDY_ITEM_GENERATE', 'STUDY_ATTEMPT_WRITE', 'AI_VISION_INVOKE', 'USAGE_READ_OWN', 'USAGE_READ_COURSE');
INSERT INTO public.role_privileges (role_id, privilege_id) SELECT r.id, p.id FROM public.roles r, public.privileges p WHERE r.name = 'ROLE_ADMIN' AND p.name IN ('NOTE_READ_OWN', 'COURSE_READ', 'COURSE_WRITE', 'COVERAGE_READ_COURSE', 'USAGE_READ_COURSE', 'USER_MANAGE', 'ROLE_MANAGE');

CREATE ROLE glifo_runtime LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD :'runtime_password';
REVOKE CREATE ON SCHEMA public FROM PUBLIC;
GRANT CONNECT ON DATABASE neondb TO glifo_runtime;
GRANT USAGE ON SCHEMA public TO glifo_runtime;
GRANT SELECT ON public.roles, public.privileges, public.role_privileges TO glifo_runtime;
GRANT SELECT, INSERT, UPDATE, DELETE ON public.ai_calls, public.attempts, public.course_glossary, public.courses, public.coverage_snapshots, public.devices, public.enrollments, public.glossary_suggestions, public.note_pages, public.notes, public.notifications, public.review_schedule, public.study_items, public.syllabus_topics, public.sync_queue, public.topic_coverage, public.user_roles, public.users TO glifo_runtime;
GRANT USAGE, SELECT ON SEQUENCE public.ai_calls_id_seq, public.attempts_id_seq, public.course_glossary_id_seq, public.courses_id_seq, public.coverage_snapshots_id_seq, public.devices_id_seq, public.enrollments_id_seq, public.glossary_suggestions_id_seq, public.note_pages_id_seq, public.notes_id_seq, public.notifications_id_seq, public.review_schedule_id_seq, public.study_items_id_seq, public.syllabus_topics_id_seq, public.sync_queue_id_seq, public.topic_coverage_id_seq, public.users_id_seq TO glifo_runtime;

COMMIT;
