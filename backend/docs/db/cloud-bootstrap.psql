    CACHE 1
);

CREATE TABLE public.notes (
    id bigint NOT NULL,
    class_date date NOT NULL,
    content jsonb,
    content_generated_at timestamp(6) with time zone,
    created_at timestamp(6) with time zone NOT NULL,
    status character varying(12) NOT NULL,
    title character varying(200) NOT NULL,
    course_id bigint NOT NULL,
    syllabus_topic_id bigint,
    user_id bigint NOT NULL,
    CONSTRAINT ck_notes_status CHECK (((status)::text = ANY ((ARRAY['DRAFT'::character varying, 'PROCESSING'::character varying, 'READY'::character varying, 'ARCHIVED'::character varying])::text[])))
);

ALTER TABLE public.notes ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.notes_id_seq
    START WITH 1
    INCREMENT BY 1
