    updated_at timestamp(6) with time zone NOT NULL,
    syllabus_topic_id bigint NOT NULL,
    user_id bigint NOT NULL,
    CONSTRAINT ck_topic_coverage_score CHECK (((score >= (0)::double precision) AND (score <= (1)::double precision))),
    CONSTRAINT ck_topic_coverage_state CHECK (((state)::text = ANY ((ARRAY['SOLID'::character varying, 'PARTIAL'::character varying, 'ABSENT'::character varying, 'UNCERTAIN'::character varying])::text[])))
);

