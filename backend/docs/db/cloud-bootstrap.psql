    course_id bigint NOT NULL,
    user_id bigint NOT NULL,
    CONSTRAINT ck_enrollments_status CHECK (((status)::text = ANY ((ARRAY['ACTIVE'::character varying, 'PENDING'::character varying, 'REMOVED'::character varying])::text[])))
);

ALTER TABLE public.enrollments ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.enrollments_id_seq
