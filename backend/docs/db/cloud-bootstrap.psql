\set ON_ERROR_STOP on
\getenv runtime_password GLIFO_RUNTIME_PASSWORD
\if :{?runtime_password}
\else
DO $missing_secret$
BEGIN
    RAISE EXCEPTION 'GLIFO_RUNTIME_PASSWORD must be supplied privately before initialization';
END
$missing_secret$;
\endif

BEGIN;
SET LOCAL lock_timeout = '5s';
SET LOCAL statement_timeout = '60s';
SET LOCAL search_path = pg_catalog;
SELECT pg_catalog.pg_advisory_xact_lock(197701, 49);

DO $guard$
BEGIN
    IF pg_catalog.current_database() <> 'neondb' OR current_user <> 'neondb_owner' THEN
        RAISE EXCEPTION 'Expected database neondb and initialization role neondb_owner';
    END IF;
    IF EXISTS (
        SELECT 1 FROM pg_catalog.pg_class relation
        JOIN pg_catalog.pg_namespace namespace ON namespace.oid = relation.relnamespace
        WHERE namespace.nspname = 'public' AND relation.relkind IN ('r', 'p', 'v', 'm', 'S', 'f')
    ) OR EXISTS (
        SELECT 1 FROM pg_catalog.pg_proc routine
        JOIN pg_catalog.pg_namespace namespace ON namespace.oid = routine.pronamespace
        WHERE namespace.nspname = 'public'
    ) OR EXISTS (
        SELECT 1 FROM pg_catalog.pg_type datatype
        JOIN pg_catalog.pg_namespace namespace ON namespace.oid = datatype.typnamespace
        WHERE namespace.nspname = 'public'
    ) THEN
        RAISE EXCEPTION 'Public schema must contain no relations, routines, or types; existing objects are never replaced';
    END IF;
    IF EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname = 'glifo_runtime') THEN
        RAISE EXCEPTION 'Role glifo_runtime already exists; refusing to alter an existing role';
    END IF;
END
$guard$;

SET LOCAL client_encoding = 'UTF8';
SET LOCAL standard_conforming_strings = on;
SET LOCAL check_function_bodies = false;
SET LOCAL xmloption = content;
SET LOCAL client_min_messages = warning;
SET LOCAL row_security = off;

SET LOCAL default_tablespace = '';

SET LOCAL default_table_access_method = heap;

CREATE TABLE public.ai_calls (
    id bigint NOT NULL,
    call_type character varying(16) NOT NULL,
    created_at timestamp(6) with time zone NOT NULL,
    estimated_cost numeric(10,6) NOT NULL,
    input_tokens integer NOT NULL,
    latency_ms integer NOT NULL,
    level character varying(12) NOT NULL,
    output_tokens integer NOT NULL,
    course_id bigint,
    user_id bigint NOT NULL,
    CONSTRAINT ck_ai_calls_level CHECK (((level)::text = ANY ((ARRAY['N0'::character varying, 'N1'::character varying, 'N1_5'::character varying, 'N2'::character varying, 'N3'::character varying, 'UNRESOLVED'::character varying])::text[]))),
    CONSTRAINT ck_ai_calls_type CHECK (((call_type)::text = ANY ((ARRAY['OCR_M'::character varying, 'IA_00'::character varying, 'IA_01'::character varying, 'IA_02'::character varying, 'IA_03'::character varying, 'IA_04'::character varying])::text[])))
);

ALTER TABLE public.ai_calls ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.ai_calls_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);

CREATE TABLE public.attempts (
    id bigint NOT NULL,
    answered_at timestamp(6) with time zone NOT NULL,
    is_correct boolean NOT NULL,
    response jsonb NOT NULL,
    study_item_id bigint NOT NULL,
    user_id bigint NOT NULL
);

ALTER TABLE public.attempts ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.attempts_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);

CREATE TABLE public.course_glossary (
    id bigint NOT NULL,
    canonical_form character varying(255) NOT NULL,
    kind character varying(20) NOT NULL,
    term character varying(120) NOT NULL,
    course_id bigint NOT NULL,
    CONSTRAINT ck_course_glossary_kind CHECK (((kind)::text = ANY ((ARRAY['TERM'::character varying, 'SYMBOL'::character varying, 'NOTATION'::character varying])::text[])))
);

ALTER TABLE public.course_glossary ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.course_glossary_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);

CREATE TABLE public.courses (
    id bigint NOT NULL,
    code character varying(20) NOT NULL,
    created_at timestamp(6) with time zone NOT NULL,
    glossary_version integer DEFAULT 1 NOT NULL,
    join_code character varying(10) NOT NULL,
    name character varying(150) NOT NULL,
    syllabus_parsed_at timestamp(6) with time zone,
    syllabus_source_uri character varying(512),
    syllabus_version integer DEFAULT 1 NOT NULL,
    term character varying(20) NOT NULL,
    owner_user_id bigint NOT NULL
);

ALTER TABLE public.courses ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
    SEQUENCE NAME public.courses_id_seq
    START WITH 1
    INCREMENT BY 1
    NO MINVALUE
    NO MAXVALUE
    CACHE 1
);

CREATE TABLE public.coverage_snapshots (
