CREATE INDEX idx_review_schedule_user_due ON public.review_schedule USING btree (user_id, due_at);

CREATE INDEX idx_study_items_course_topic ON public.study_items USING btree (course_id, syllabus_topic_id);

CREATE INDEX idx_syllabus_topics_course ON public.syllabus_topics USING btree (course_id, parent_id, order_index);

CREATE INDEX idx_sync_queue_status ON public.sync_queue USING btree (status, created_at);

CREATE INDEX idx_topic_coverage_user ON public.topic_coverage USING btree (user_id);

