    payload jsonb NOT NULL,
    status character varying(12) NOT NULL,
    device_id bigint NOT NULL,
    user_id bigint NOT NULL,
    CONSTRAINT ck_sync_queue_status CHECK (((status)::text = ANY ((ARRAY['PENDING'::character varying, 'IN_PROGRESS'::character varying, 'FAILED'::character varying, 'DONE'::character varying])::text[])))
);

ALTER TABLE public.sync_queue ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
