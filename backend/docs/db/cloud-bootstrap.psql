    CONSTRAINT ck_study_items_kind_matches_payload CHECK (((payload ->> 'kind'::text) = (kind)::text)),
    CONSTRAINT ck_study_items_payload_version CHECK (((payload -> 'schemaVersion'::text) IS NOT NULL))
);

ALTER TABLE public.study_items ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
