    CONSTRAINT ck_notifications_kind CHECK (((kind)::text = ANY ((ARRAY['SYNC_COMPLETE'::character varying, 'REVIEW_DUE'::character varying, 'COVERAGE_DROP'::character varying])::text[])))
);

ALTER TABLE public.notifications ALTER COLUMN id ADD GENERATED BY DEFAULT AS IDENTITY (
