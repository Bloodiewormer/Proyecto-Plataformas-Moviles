OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Clave para firmar los JWT. Opcional en desarrollo: si no se define, se usa la de desarrollo.
# En producción debe ser un valor largo y aleatorio (mínimo 32 caracteres). Quitá el # para usarla.
# JWT_SECRET=

# Notificaciones push con Firebase Cloud Messaging (issue #48)
GLIFO_FCM_ENABLED=true
GLIFO_FCM_PROJECT_ID=glifoapp
#GLIFO_FCM_CREDENTIALS_PATH=
#GLIFO_FCM_CREDENTIALS_FILE=
GLIFO_FCM_USE_APPLICATION_DEFAULT=false
#GLIFO_FCM_MAX_ATTEMPTS=
#GLIFO_FCM_RETRY_BACKOFF_MS=

# Tarifas en USD por millón de tokens (issue #46). Verificar precios vigentes en la página oficial de OpenAI.
# Comentadas a propósito: una variable vacía pisa el valor por defecto de application.properties y
# Spring no arranca ("" no es un número). Descomentar solo para poner un precio distinto.
#GLIFO_PRICE_GPT4OMINI_INPUT=
#GLIFO_PRICE_GPT4OMINI_OUTPUT=
#GLIFO_PRICE_GPT4O_INPUT=
#GLIFO_PRICE_GPT4O_OUTPUT=
