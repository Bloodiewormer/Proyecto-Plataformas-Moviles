                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test('Created course returns id, 8-char join_code and PENDING syllabus_status in data', function () {",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data.id).to.be.a('number');",
                  "    pm.expect(jsonData.data.join_code).to.be.a('string').and.have.lengthOf(8);",
                  "    pm.expect(jsonData.data.syllabus_status).to.eql('PENDING');",
                  "});",
                  "",
