      "name": "01 - Health",
      "item": [
        {
          "name": "GET Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jsonData = pm.response.json();",
                  "pm.test('Response wraps payload in data with status UP', function () {",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData.data.status).to.eql('UP');",
                  "    pm.expect(jsonData.data.service).to.eql('glifo-api');",
                  "});",
                  "console.info('Health status:', jsonData.data.status);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{host}}/api/{{version}}/health",
              "host": [
                "{{host}}"
              ],
              "path": [
                "api",
                "{{version}}",
                "health"
              ]
            }
          }
        }
      ]
    },
